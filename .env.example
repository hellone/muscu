# Copier en .env sur le serveur et adapter
MUSCU_DOMAIN=muscu.courtside-basket.fr
# Code demandé à l'inscription (laisser vide = inscription libre). Conseillé : le site est public.
CODE_INVITATION=choisir-un-code
# Valeurs du Traefik de n8n (les mêmes que pour Courtside)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge
# Strava (facultatif) : créer une application sur https://www.strava.com/settings/api
#   « Authorization Callback Domain » : muscu.courtside-basket.fr
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
